    "@prisma/client": "^5.22.0",
    "axios": "^1.7.0",
    "bcryptjs": "^3.0.3",
    "bufferutil": "^4.1.0",
    "clsx": "^2.1.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.11.0",
    "groq-sdk": "^0.8.0",
    "highlight.js": "^11.10.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.460.0",
    "next": "^14.2.35",
    "nextjs-toploader": "^3.9.17",
    "prisma": "^5.22.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-dropzone": "^14.2.0",
    "react-hot-toast": "^2.4.0",
